# ==============================================================================
# .env.example - payment-ms
# Template de variáveis de ambiente para execução local e desenvolvimento.
# Copie este arquivo para .env: `cp .env.example .env`
# NUNCA commite senhas, tokens ou segredos reais de produção neste arquivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# Configuração do Servidor HTTP (Fastify)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Banco de Dados PostgreSQL (Payment DB)
# Em ambiente local sem Docker, use DB_HOST=localhost e DB_PORT=5433 (porta exposta).
# Na rede Docker (docker-compose), use DB_HOST=payment-postgres e DB_PORT=5432.
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payment_db
DB_POOL_MAX=10

# URL de conexão alternativa para ferramentas de migração/inspeção (DBeaver / Prisma / etc.)
# Formato: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/payment_db

# ------------------------------------------------------------------------------
# Mensageria RabbitMQ
# Em ambiente local sem Docker, use RABBITMQ_HOST=localhost.
# Na rede Docker, use RABBITMQ_HOST=rabbitmq.
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ------------------------------------------------------------------------------
# Topologia AMQP - Consumo de Pedidos
# ------------------------------------------------------------------------------
RABBITMQ_ORDER_EVENTS_EXCHANGE=order.events
RABBITMQ_ORDER_CREATED_ROUTING_KEY=order.created
RABBITMQ_PAYMENT_QUEUE=payment-service.order-created
RABBITMQ_DLX=ecommerce.dlx
RABBITMQ_DLQ=payment-service.order-created.dlq

# ------------------------------------------------------------------------------
# Topologia AMQP - Publicação de Pagamentos (CDC Debezium)
# ------------------------------------------------------------------------------
RABBITMQ_PAYMENT_EVENTS_EXCHANGE=payment.events

# ------------------------------------------------------------------------------
# Simulação do Gateway de Pagamento (Mock Adquirente)
# Controla a latência artificial mínima e máxima em milissegundos
# ------------------------------------------------------------------------------
GATEWAY_MIN_DELAY_MS=300
GATEWAY_MAX_DELAY_MS=1800
